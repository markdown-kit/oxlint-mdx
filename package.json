{
  "name": "@markdownkit/oxlint-mdx",
  "version": "4.0.0",
  "description": "Oxlint-first MD/MDX linter with diagnostic and autofix remapping",
  "keywords": [
    "lint",
    "markdown",
    "mdx",
    "oxlint",
    "remark"
  ],
  "license": "MIT",
  "bin": {
    "oxlint-mdx": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx src/cli.ts",
    "test": "vitest run --maxWorkers=1",
    "parity:matrix": "tsx scripts/parity-matrix.ts",
    "parity:gaps": "tsx scripts/parity-gaps.ts",
    "prepublishOnly": "pnpm run typecheck && pnpm run build",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:ci": "oxlint --deny-warnings .",
    "lint:fix": "oxlint --fix .",
    "lint:fix-unsafe": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously .",
    "check:fix-suggestions": "oxlint --import-plugin --node-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions . && oxfmt --write .",
    "check": "pnpm run format:check && pnpm run lint:ci && pnpm run typecheck",
    "check:full": "pnpm run check && pnpm run test",
    "release": "release-kit"
  },
  "dependencies": {
    "@oxlint/plugins": "^1.83.0",
    "execa": "^10.0.1",
    "fast-glob": "^3.3.3",
    "oxlint": "1.83.0",
    "remark-frontmatter": "^5.0.0",
    "remark-lint-fenced-code-flag": "^4.2.0",
    "remark-lint-no-duplicate-headings-in-section": "^4.0.1",
    "remark-lint-no-multiple-toplevel-headings": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "remark-validate-links": "^13.1.0",
    "unified": "^11.0.5",
    "unified-engine": "^11.2.2",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3"
  },
  "devDependencies": {
    "@entro314labs/release-kit": "^2.9.4",
    "@types/mdast": "^4.0.4",
    "@types/node": "^26.6.1",
    "oxfmt": "^0.68.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsx": "^4.23.13",
    "typescript": "rc",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
